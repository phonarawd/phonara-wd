{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.ts",
        "tests/**/*.{ts,tsx}",
        "playwright*.config.ts",
        "vitest.config.ts",
        ".cursor/hooks/**/*.ts"
      ],
      "project": [
        "scripts/**/*.ts",
        "tests/**/*.{ts,tsx}",
        "playwright*.config.ts",
        "vitest.config.ts",
        ".cursor/hooks/**/*.ts"
      ]
    },
    "apps/admin": {
      "entry": [
        "vite.config.ts",
        "src/contexts/**/*.tsx",
        "src/domain/**/*.ts",
        "src/hooks/**/*.ts",
        "src/lib/**/*.ts",
        "src/product/**/*.{ts,tsx}",
        "src/routes/**/*.tsx",
        "src/shared-types/**/*.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["src/main.tsx"],
      "ignoreDependencies": ["tailwindcss"],
      "paths": {
        "@/*": ["src/*"]
      }
    },
    "apps/web": {
      "entry": [
        "vite.config.ts",
        "src/contexts/**/*.tsx",
        "src/contracts/**/*.ts",
        "src/data/**/*.ts",
        "src/domain/**/*.ts",
        "src/features/**/*.ts",
        "src/hooks/**/*.ts",
        "src/lib/**/*.ts",
        "src/product/**/*.{ts,tsx}",
        "src/routes/**/*.tsx",
        "src/stores/**/*.ts",
        "src/workers/**/*.ts",
        "src/sw.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["src/main.tsx"],
      "ignoreDependencies": ["tailwindcss"],
      "paths": {
        "@/*": ["src/*"]
      }
    }
  }
}
