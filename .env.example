# After Lovable casino ZIP paste: switch casino routes to GameSurfaceLoader (legacy @phonara/ui off).
# Visual baseline captures (placeholder balances — Playwright mockup-diff only; not `bun run dev`)
# VITE_PHONARA_VISUAL_FIXTURE=1

# Optional dev guest: browse protected routes without login (mock wallet/home). Off by default.
# Root `/` always shows landing; `/login` stays real UX. Enable only when needed:
# VITE_PHONARA_DEV_GUEST=1

# Ad pixels — landing/auth chunk only; load after analytics consent (§28.5). Empty = disabled.
# VITE_TIKTOK_PIXEL_ID=
# VITE_META_PIXEL_ID=
# VITE_GOOGLE_TAG_ID=G-XXXXXXXXXX

# DEV: keep stale service workers (default: auto-unregister + clear Cache Storage on dev boot)
# VITE_PHONARA_KEEP_SERVICE_WORKER=1

# Supabase Management API — used by `bun run check:advisors` (NOT for browser/VITE_).
# Create at https://supabase.com/dashboard/account/tokens or run `supabase login` (CLI stores token in OS keychain).
# Agent/Cursor workspace: use a READ-ONLY PAT here. Migration-write PAT lives on operator machine only.
# Personal access token — advisors/list/query + `bun run stack:push-remote` (원격 apply 정본)
# SUPABASE_ACCESS_TOKEN=sbp_your_personal_access_token
# SUPABASE_PROJECT_ID=yocjhjsdwoijfdrehzoq
#
# Prod migration apply (Phase 4 S3) — operator-only, **outside Cursor** (hooks always deny db push).
# Optional audit flag for operator external shell only (hooks ignore this).
# PHONARA_ALLOW_PROD_DB_PUSH=1
#
# Docker on-demand (Windows low-spec — see .cursor/rules/84-docker-on-demand.mdc)
# PHONARA_DOCKER_AUTO_START=1   # pretest:e2e/sql launches Docker Desktop if off (default ON)
# PHONARA_DOCKER_AUTO_QUIT=1    # posttest stack:stop quits Docker Desktop — WSL RAM release (default ON)
# PHONARA_KEEP_STACK=1          # back-to-back E2E+SQL — skip supabase stop + Docker quit
# PHONARA_SKIP_DOCKER_CLEAN=1   # skip docker prune after stack:stop
#
# Custom SMTP for signup/reset emails (server-only — then run `bun run auth:sync-email`)
# SUPABASE_SMTP_HOST=smtp.resend.com
# SUPABASE_SMTP_PORT=587
# SUPABASE_SMTP_USER=resend
# SUPABASE_SMTP_PASS=re_your_key
# SUPABASE_SMTP_ADMIN_EMAIL=no-reply@phonara.net
# SUPABASE_SMTP_SENDER_NAME=PHONARA

# Sportsbook odds ingest (server/worker only — NEVER VITE_*)
# Keys: both can be set — worker auto-failover when SPORTS_ODDS_VENDOR=auto
THE_ODDS_API_KEY=your_the_odds_api_key
# ODDS_API_IO_KEY=your_odds_api_io_key
# SPORTSGAMEODDS_API_KEY=your_sportsgameodds_api_key
SPORTS_ODDS_VENDOR=auto
# SPORTS_ODDS_VENDOR_PRIORITY=the-odds-api,odds-api-io,sportsgameodds
# Bookmakers via legal APIs (NOT Bet365/OddsPortal/1xBet web scraping)
# Odds-API.io names: Bet365, 1xBet, Pinnacle · The Odds API keys: onexbet, pinnacle, williamhill
# SPORTS_ODDS_IO_BOOKMAKERS=Bet365,1xBet,Pinnacle
# SPORTS_ODDS_BOOKMAKERS=onexbet,pinnacle,williamhill
SPORTS_ODDS_REGIONS=uk,eu
# SPORTS_ODDS_MARKETS=h2h,totals
# SPORTS_ODDS_BOOKMAKER=williamhill
SPORTS_INGEST_LEAGUES=epl,k-league
SPORTS_INGEST_DRY_RUN=true
SPORTS_SETTLE_DRY_RUN=true
# Dual-feed settlement: The Odds API scores + football-data.org cross-check (football leagues)
# FOOTBALL_DATA_API_KEY=your_football_data_org_token
# SPORTS_SETTLE_DUAL_FEED=true
# SPORTS_SETTLE_DUAL_FEED_STRICT=true
# SPORTS_SETTLE_LEAGUES=epl,k-league

# Wave-S10: Odds-API.io WebSocket live ingest (requires ODDS_API_IO_KEY + WS add-on)
# SPORTS_WS_MARKETS=ML,Totals
# SPORTS_WS_CHANNELS=odds,scores,status
# SPORTS_WS_STATUS=live
# SPORTS_WS_STALL_MS=120000

# Wave-S11: 24/7 orchestrator (REST poll + WS child + settle + ops alerts)
# SPORTS_REST_INTERVAL_MS=300000
# SPORTS_SETTLE_INTERVAL_MS=900000
# SPORTS_OPS_ALERT_INTERVAL_MS=600000
# SPORTS_ORCHESTRATOR_WS=true

# Odds-API.io (alternative — live WS ingest deferred; auto mode uses as fallback when key set)
# ODDS_API_IO_KEY=your_odds_api_io_key
# SPORTS_ODDS_VENDOR=the-odds-api

# ─── Edge Functions + server-only (NEVER VITE_* / NEVER commit .env.local) ───
# Supabase (Edge / scripts — browser uses VITE_SUPABASE_* above)
SUPABASE_URL=YOUR_VALUE_HERE
SUPABASE_ANON_KEY=YOUR_VALUE_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_VALUE_HERE

# PG Bank Webhook (supabase/functions/pg-bank-webhook)
PG_BANK_WEBHOOK_SECRET=YOUR_VALUE_HERE

# Crypto rails (derive-crypto-address · crypto-sign · crypto-chain-watcher)
# Code also reads: CRYPTO_TRON_XPUB · CRYPTO_ETH_XPUB · CRYPTO_HOT_WALLET_PRIVATE_KEY
CRYPTO_HD_MASTER_KEY=YOUR_VALUE_HERE
CRYPTO_WITHDRAW_SIGNER_KEY=YOUR_VALUE_HERE
TRONGRID_API_KEY=YOUR_VALUE_HERE
ETHERSCAN_API_KEY=YOUR_VALUE_HERE

# Notification outbound dispatch (notification-dispatch)
# Code env names: WEB_PUSH_DISPATCH_HMAC_SECRET · EMAIL_DISPATCH_HMAC_SECRET
WEB_PUSH_DISPATCH_URL=YOUR_VALUE_HERE
WEB_PUSH_DISPATCH_SECRET=YOUR_VALUE_HERE
EMAIL_DISPATCH_URL=YOUR_VALUE_HERE
EMAIL_DISPATCH_SECRET=YOUR_VALUE_HERE

# Ops pager (ops-notify edge) — ntfy free push (recommended) and/or Telegram
# ntfy one-shot setup: bun run stack:setup-ops-ntfy
# sync secrets: bun run stack:sync-ops-pager-secrets
# test: bun run stack:test-ops-pager
OPS_NTFY_SERVER=https://ntfy.sh
OPS_NTFY_TOPIC=
# Optional — ntfy Click deep-link to Admin 처리 대기함 (e.g. https://admin.example.com)
OPS_ADMIN_PUBLIC_URL=
# OPS_NTFY_TOKEN=

# Telegram (optional fallback)
# 1) BotFather /getUpdates 로 받은 값을 아래에 넣기 (.env 는 Git 에 올라가지 않음)
# 2) bun run stack:sync-ops-telegram-secrets  → Supabase Edge secrets 로 업로드
# 3) bun run stack:sync-ops-telegram-secrets -- --check  → .env 만 검증 (업로드 X)
# Edge 코드 env 이름: OPS_TELEGRAM_WEBHOOK_HMAC_SECRET · OPS_TELEGRAM_FALLBACK_HMAC_SECRET
OPS_TELEGRAM_BOT_TOKEN=YOUR_VALUE_HERE
OPS_TELEGRAM_CHAT_ID=YOUR_VALUE_HERE
# optional — HMAC webhook primary / fallback (없으면 Bot API 만 사용)
OPS_TELEGRAM_WEBHOOK_URL=
OPS_TELEGRAM_WEBHOOK_HMAC_SECRET=
OPS_TELEGRAM_FALLBACK_URL=
OPS_TELEGRAM_FALLBACK_HMAC_SECRET=

# Next.js-style public keys (Phase R — if using NEXT_PUBLIC_* instead of VITE_*)
NEXT_PUBLIC_SUPABASE_URL=YOUR_VALUE_HERE
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_VALUE_HERE
