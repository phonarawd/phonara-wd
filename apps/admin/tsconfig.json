{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "../../node_modules/.cache/tsbuild/admin.tsbuildinfo",
    "outDir": "dist",
    "paths": {
      "@/*": ["./src/*"],
      "@phonara/shared-types": ["../../packages/shared-types/src"],
      "@phonara/money": ["../../packages/money/src"],
      "@phonara/i18n": ["../../packages/i18n/src"],
      "@phonara/i18n/react": ["../../packages/i18n/src/react"]
    }
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["src/**/__tests__/**", "src/**/*.test.ts", "src/**/*.test.tsx"],
  "references": [
    { "path": "../../packages/i18n" },
    { "path": "../../packages/money" },
    { "path": "../../packages/shared-types" }
  ]
}
