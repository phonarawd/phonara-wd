{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "../../node_modules/.cache/tsbuild/web.tsbuildinfo",
    "outDir": "dist",
    "paths": {
      "@/*": ["./src/*"],
      "react-router-dom": ["./src/shims/react-router-dom.tsx"],
      "@phonara/shared-types": ["../../packages/shared-types/src"],
      "@phonara/money": ["../../packages/money/src"],
      "@phonara/wallet-ledger": ["../../packages/wallet-ledger/src"],
      "@phonara/trading-engine": ["../../packages/trading-engine/src"],
      "@phonara/game-engine": ["../../packages/game-engine/src"],
      "@phonara/i18n": ["../../packages/i18n/src"],
      "@phonara/i18n/react": ["../../packages/i18n/src/react"],
      "@phonara/ui": ["../../packages/ui/src"]
    }
  },
  "include": ["src"],
  "references": [
    { "path": "../../packages/i18n" },
    { "path": "../../packages/money" },
    { "path": "../../packages/shared-types" },
    { "path": "../../packages/game-engine" },
    { "path": "../../packages/trading-engine" },
    { "path": "../../packages/ui" }
  ]
}
