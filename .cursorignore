# Dependencies and package manager caches (largest index noise)
node_modules/
.bun/
**/node_modules/
**/node_modules/.cache/

# Build and test artifacts
dist/
**/dist/
build/
coverage/
test-results/
playwright-report/
blob-report/
.turbo/
.vite/
**/.vite/
**/node_modules/.vite/
*.tsbuildinfo
.eslintcache
**/.playwright-artifacts*/

# Generated app + package outputs (rebuilt by build scripts)
apps/*/dist/
packages/*/dist/
backups/

# Supabase CLI local state + generated SQL mirror
supabase/.temp/
supabase/.branches/
supabase/functions-sql/

# E2E ephemeral auth (tokens — also in .gitignore)
tests/e2e/.auth.json
tests/e2e/.admin-auth.json
tests/e2e/.*auth*.json

# Lockfile is generated; exclude from semantic index (still on disk for installs)
bun.lock

# Large / archival / generated docs (duplicate index noise)
project_dump.md
docs/PHONARA_V2_MASTER_PLAN.md
docs/AUDIT_REPORT_2026-06-11.md
docs/AUDIT_FINAL_REPORT.md
docs/PHONARA_UI_UX_REBUILD_LOG.md

# Playwright screenshots/traces from local runs (if any escape test-results)
**/*.png.snap
**/trace.zip
