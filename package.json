{
  "name": "phonara-gb",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @phonara/web dev",
    "dev:web": "bun --filter @phonara/web dev",
    "dev:admin": "bun --filter @phonara/admin dev",
    "dev:admin:local": "tsx scripts/dev-admin-local.ts",
    "seed:local-admin": "tsx scripts/seed-local-admin-dev.ts",
    "pentest:money-path": "tsx scripts/pentest/p0-money-path-dynamic.ts",
    "pentest:law1-game-integrity": "tsx scripts/pentest/law1-game-integrity-dynamic.ts",
    "gameday:drill": "tsx scripts/game-day/gameday-drill.ts",
    "build": "bun run build:packages && bun run build:apps",
    "build:apps": "bun --filter @phonara/web build && bun --filter @phonara/admin build",
    "build:packages": "tsc -b --force packages/shared-types packages/i18n packages/money packages/wallet-ledger packages/trading-engine packages/market-display packages/game-engine packages/sportsbook-engine packages/sports-ingest packages/ui",
    "sports:ingest:dry": "tsx scripts/sports-odds-ingest/run.ts",
    "sports:ingest": "tsx scripts/sports-odds-ingest/run.ts",
    "sports:ingest:ws:dry": "tsx scripts/sports-odds-ingest/ws-run.ts",
    "sports:ingest:ws": "tsx scripts/sports-odds-ingest/ws-run.ts",
    "sports:orchestrator:dry": "tsx scripts/sports-orchestrator/run.ts",
    "sports:orchestrator": "tsx scripts/sports-orchestrator/run.ts",
    "sports:settle:dry": "tsx scripts/sports-settle/run.ts",
    "sports:settle": "tsx scripts/sports-settle/run.ts",
    "typecheck": "tsc -b tsconfig.json",
    "typecheck:force": "tsc -b --force tsconfig.json",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/.eslintcache",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "tsx scripts/cursor-kill-orphans.ts",
    "pretest:sql": "tsx scripts/ensure-dev-stack.ts --full --quiet",
    "test": "vitest run",
    "test:web": "vitest run --project web",
    "test:game-engine": "vitest run packages/game-engine/src",
    "posttest": "bun run clean:artifacts",
    "test:coverage": "vitest run --coverage",
    "posttest:coverage": "bun run clean:artifacts",
    "test:sql": "tsx scripts/run-sql-tests.ts",
    "posttest:sql": "tsx scripts/stack-stop.ts --quiet",
    "pretest:e2e": "tsx scripts/cursor-kill-orphans.ts && tsx scripts/e2e-kill.ts && tsx scripts/ensure-dev-stack.ts --full --quiet && tsx scripts/ensure-e2e-packages.ts",
    "test:e2e": "tsx scripts/run-e2e.ts",
    "posttest:e2e": "bun run clean:artifacts && tsx scripts/stack-stop.ts --quiet",
    "pretest:e2e:casino-smoke": "tsx scripts/cursor-kill-orphans.ts && tsx scripts/e2e-kill.ts && tsx scripts/ensure-dev-stack.ts --full --quiet && tsx scripts/ensure-e2e-packages.ts",
    "test:e2e:casino-smoke": "tsx scripts/run-e2e.ts --config playwright.casino-smoke.config.ts",
    "posttest:e2e:casino-smoke": "bun run clean:artifacts && tsx scripts/stack-stop.ts --quiet",
    "pretest:e2e:casino": "tsx scripts/cursor-kill-orphans.ts && tsx scripts/e2e-kill.ts && tsx scripts/ensure-dev-stack.ts --full --quiet && tsx scripts/ensure-e2e-packages.ts",
    "test:e2e:casino": "tsx scripts/run-e2e.ts --config playwright.casino.config.ts",
    "posttest:e2e:casino": "bun run clean:artifacts && tsx scripts/stack-stop.ts --quiet",
    "test:e2e:sports-engine": "tsx scripts/run-e2e.ts --config playwright.sports-engine.config.ts",
    "posttest:e2e:sports-engine": "bun run clean:artifacts && tsx scripts/stack-stop.ts --quiet",
    "e2e:kill": "tsx scripts/e2e-kill.ts",
    "check": "bun run check:env && bun run check:hygiene && bun run check:i18n && bun run check:release && bun run check:advisors && bun run check:migrations && bun run check:games && bun run check:determinism && bun run check:deps && bun run typecheck && bun run lint && bun run test && bun run build",
    "check:full": "tsx scripts/run-full-gate.ts",
    "check:env": "tsx scripts/check-env.ts",
    "check:i18n": "tsx scripts/check-i18n-coverage.ts",
    "check:deps": "knip --dependencies --no-progress --workspace \"@phonara/*\"",
    "check:pwa": "tsx scripts/check-pwa.ts",
    "check:release": "tsx scripts/check-release.ts",
    "check:hygiene": "tsx scripts/check-workspace-hygiene.ts",
    "check:advisors": "tsx scripts/check-advisors.ts",
    "check:migrations": "tsx scripts/check-migrations.ts",
    "check:games": "tsx scripts/check-game-registration.ts",
    "check:determinism": "tsx scripts/check-determinism.ts",
    "check:guard-coverage": "tsx scripts/check/guard-coverage.ts",
    "lock:migrations": "tsx scripts/check-migrations.ts --write",
    "check:functions-mirror": "tsx scripts/generate-functions-mirror.ts --check",
    "mirror:functions": "tsx scripts/generate-functions-mirror.ts",
    "clean": "bun run clean:artifacts",
    "clean:artifacts": "tsx scripts/clean-artifacts.ts",
    "cursor:preflight": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cursor-preflight.ps1",
    "cursor:kill-orphans": "tsx scripts/cursor-kill-orphans.ts",
    "cursor:status": "tsx scripts/cursor-status.ts",
    "cursor:emergency-reset": "tsx scripts/cursor-emergency-reset.ts",
    "cursor:session-start": "tsx scripts/cursor-session-hygiene.ts start",
    "cursor:session-end": "tsx scripts/cursor-session-hygiene.ts end",
    "cursor:after-heavy-shell": "tsx scripts/cursor-session-hygiene.ts after-heavy",
    "cursor:before-heavy-shell": "tsx scripts/cursor-session-hygiene.ts before-heavy",
    "cursor:hook:session-start": "tsx scripts/cursor-hook.ts session-start",
    "cursor:hook:session-stop": "tsx scripts/cursor-hook.ts session-stop",
    "cursor:hook:after-shell": "tsx scripts/cursor-hook.ts after-shell",
    "cursor:hook:before-shell": "tsx scripts/cursor-hook.ts before-shell",
    "cursor:sync-excludes": "tsx scripts/sync-cursor-archival-excludes.ts",
    "cursor:clean-metadata": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cursor-clean-metadata.ps1",
    "cursor:av-exclusions": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/configure-antivirus-exclusions.ps1 -OpenV3Lite",
    "rehearsal:backup": "tsx scripts/backup-rehearsal.ts",
    "dump:engine": "tsx scripts/engine-state-dump.ts",
    "dump:engine:ultimate": "tsx scripts/engine-state-dump.ts --ultimate",
    "setup": "tsx scripts/setup-dev-environment.ts",
    "setup:playwright": "bunx playwright install chromium",
    "supabase": "bunx supabase",
    "mcp:fix": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fix-cursor-mcp.ps1",
    "mcp:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-supabase-mcp.ps1",
    "lovable:intake": "tsx scripts/lovable-paste-intake.ts",
    "lovable:paste": "tsx scripts/lovable-paste-apply.ts",
    "lovable:postcheck": "tsx scripts/lovable-paste-postcheck.ts",
    "lovable:baseline": "tsx scripts/lovable-paste-postcheck.ts -- --capture-baseline",
    "cursor:pre-paste": "tsx scripts/cursor-pre-paste.ts",
    "docs:consolidate": "tsx scripts/docs-consolidate.ts",
    "stack:ensure": "tsx scripts/ensure-dev-stack.ts",
    "stack:ensure:full": "tsx scripts/ensure-dev-stack.ts --full",
    "stack:stop": "tsx scripts/stack-stop.ts",
    "stack:docker-clean": "tsx scripts/stack-docker-clean.ts",
    "stack:supabase:login": "tsx scripts/ensure-dev-stack.ts --auth-only",
    "stack:docker": "tsx scripts/ensure-dev-stack.ts --docker-only"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.8.0",
    "globals": "^17.6.0",
    "jsdom": "^26.1.0",
    "knip": "^6.16.1",
    "otplib": "^13.4.1",
    "playwright": "^1.60.0",
    "prettier": "^3.8.4",
    "supabase": "2.106.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@phonara/sports-ingest": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slider": "^1.4.0",
    "@radix-ui/react-slot": "^1.2.5",
    "@supabase/supabase-js": "^2.108.1",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.15",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.18.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
