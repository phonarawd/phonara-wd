    "sports:ingest:dry": "tsx scripts/sports-odds-ingest/run.ts",
    "sports:ingest": "tsx scripts/sports-odds-ingest/run.ts",
    "sports:ingest:ws:dry": "tsx scripts/sports-odds-ingest/ws-run.ts",
