{
  "name": "phonara-gb",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @phonara/web dev",
    "dev:web": "bun --filter @phonara/web dev",
    "dev:web:local": "tsx scripts/dev-web-local.ts",
    "dev:admin": "bun --filter @phonara/admin dev",
    "dev:admin:local": "tsx scripts/dev-admin-local.ts",
    "seed:local-admin": "tsx scripts/seed-local-admin-dev.ts",
    "seed:local-trade": "tsx scripts/seed-local-trade-dev.ts",
