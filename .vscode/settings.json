{
  "files": {
    "watcherExclude": {
      "**/.git/**": true,
      "**/.git/objects/**": true,
      "**/.git/subtree-cache/**": true,
      "**/node_modules/**": true,
      "**/.bun/**": true,
      "**/dist/**": true,
      "**/build/**": true,
      "**/coverage/**": true,
      "**/.vite/**": true,
      "**/test-results/**": true,
      "**/engine-dump/**": true,
      "**/.paste-intake/**": true,
      "**/.tmp/**": true,
      "**/.tmp-presentation-*/**": true,
      "**/playwright-report/**": true,
      "**/packages/*/dist/**": true,
      "**/apps/*/dist/**": true,
      "**/.tmp-zip-extract/**": true,
      "**/_audit/**": true,
      "**/*.zip": true,
      "**/gate-manifest/**": true,
      "**/docs_archive/**": true,
      "**/archive/**": true,
      "**/docs/archive/**": true,
      "**/tests/visual/mockups/**": true,
      "**/tests/visual/m0-baselines/**": true,
      "**/docs/RELEASE_ROADMAP.md": true,
      "**/docs/rebuild/LOWSPEC_RULES.md": true,
      "**/screenshots/**": true
    },
    "exclude": {
      "**/dist": true,
      "**/.vite": true,
      "**/test-results": true,
      "**/playwright-report": true,
      "**/blob-report": true,
      "**/coverage": true
    }
  },
  "search": {
    "exclude": {
      "**/node_modules": true,
      "**/.bun": true,
      "**/dist": true,
      "**/build": true,
      "**/coverage": true,
      "**/.vite": true,
      "**/test-results": true,
      "**/playwright-report": true,
      "**/blob-report": true,
      "**/.turbo": true,
      "**/supabase/.temp": true,
      "**/supabase/.branches": true,
      "**/supabase/functions-sql": true,
      "**/packages/*/dist": true,
      "**/apps/*/dist": true,
      "**/backups": true,
      "**/_audit": true,
      "**/*.zip": true,
      "**/public/fonts": true,
      "bun.lock": true,
      "**/docs_archive/**": true,
      "**/archive/**": true,
      "**/docs/archive/**": true,
      "**/tests/visual/mockups/**": true,
      "**/tests/visual/m0-baselines/**": true,
      "**/docs/RELEASE_ROADMAP.md": true,
      "**/docs/rebuild/LOWSPEC_RULES.md": true,
      "**/screenshots/**": true
    },
    "followSymlinks": false
  },
  "explorer": {
    "excludeGitIgnore": true
  },
  "npm": {
    "autoDetect": "off"
  },
  "git": {
    "autorefresh": false,
    "untrackedChanges": "hidden",
    "ignoreLimitWarning": true
  },
  "typescript": {
    "tsserver": {
      "maxTsServerMemory": 768,
      "useSyntaxServer": "auto",
      "experimental": {
        "enableProjectDiagnostics": false
      }
    },
    "disableAutomaticTypeAcquisition": true,
    "enablePromptUseWorkspaceTsdk": true,
    "updateImportsOnFileMove.enabled": "never",
    "suggest.autoImports": true
  },
  "editor.formatOnSave": false,
  "editor.codeActionsOnSave": {},
  "editor.minimap.enabled": false,
  "editor.inlayHints.enabled": "off",
  "editor.codeLens": false,
  "editor.bracketPairColorization.enabled": false,
  "editor.guides.bracketPairs": false,
  "scm.diffDecorations": "none",
  "git.decorations.enabled": false,
  "workbench.editor.enablePreview": false,
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.value": 8,
  "window.restoreWindows": "one",
  "workbench.startupEditor": "none",
  "workbench.localHistory.enabled": false,
  "workbench.editor.restoreViewState": false,
  "search.maintainFileSearchCache": false,
  "git.autofetch": false,
  "extensions.autoUpdate": false,
  "search.maxResults": 5000,
  "javascript": {
    "validate": {
      "enable": false
    }
  },
  "eslint": {
    "useFlatConfig": true,
    "workingDirectories": [
      {
        "pattern": "./apps/*"
      },
      {
        "pattern": "./packages/*"
      }
    ]
  },
  "css.lint.unknownAtRules": "ignore",
  "scss.lint.unknownAtRules": "ignore",
  "terminal.integrated.defaultProfile.windows": "PHONARA PowerShell",
  "terminal.integrated.profiles.windows": {
    "PHONARA PowerShell": {
      "source": "PowerShell",
      "args": [
        "-NoExit",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/phonara-terminal.ps1"
      ]
    },
    "PowerShell": {
      "source": "PowerShell"
    }
  },
  "terminal.integrated.env.windows": {
    "PHONARA_BUN_EXE": "${env:APPDATA}/npm/node_modules/bun/bin/bun.exe"
  }
}
